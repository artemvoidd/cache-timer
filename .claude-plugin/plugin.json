{
  "name": "cache-timer",
  "displayName": "Cache Timer",
  "version": "1.0.0",
  "description": "Shows in the footer how long the prompt cache stays warm, so you ask your next question before it expires",
  "author": { "name": "Artem Void", "url": "https://github.com/artemvoidd" },
  "homepage": "https://github.com/artemvoidd/cache-timer",
  "repository": "https://github.com/artemvoidd/cache-timer",
  "license": "MIT",
  "keywords": ["mod", "prompt-cache", "footer", "status", "timer"],
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Language",
      "description": "Language of the footer label",
      "options": ["en", "ru"],
      "default": "en"
    }
  }
}
